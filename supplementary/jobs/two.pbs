#!/bin/bash
#PBS -N supplement_two
#PBS -q auto_free
#PBS -l select=2:ncpus=8:mpiprocs=8:ompthreads=1:mem=8gb
#PBS -l place=scatter
#PBS -l walltime=02:00:00
#PBS -j oe
set -e
source /etc/profile || true
module load gompi/2024a
set -uo pipefail
PROJECT="$PBS_O_WORKDIR"
RUN_ROOT="${PROJECT3_SUPPLEMENT_RUN_ROOT:-/scratch/$USER/project3_supplement_runs}"
RUN="$RUN_ROOT/supplement_two_$PBS_JOBID"
BACKUP="$HOME/dsa5208_project3_supplement_20261117/runs/supplement_two_$PBS_JOBID"
mkdir -p "$RUN" "$BACKUP"
finish() {
    status=$?
    set +e
    for item in results src scripts Makefile environment.txt pbs_record.txt; do
        if [ -e "$RUN/$item" ]; then cp -a "$RUN/$item" "$BACKUP/"; fi
    done
    echo "JOB_EXIT_CODE=$status"
    exit "$status"
}
trap finish EXIT
cp -a "$PROJECT/src" "$PROJECT/scripts" "$PROJECT/Makefile" "$RUN/"
cd "$RUN"
{
    date -Is
    hostname
    module -t list 2>&1
    g++ --version
    mpiexec --version
    cat "$PBS_NODEFILE"
} > environment.txt 2>&1
qstat -f "$PBS_JOBID" > pbs_record.txt
make -j2
unset JACOBI_BINDING
python3 scripts/supplement.py --nodes 2 --iterations 3000 --repeats 7 --output results/supplement
echo "SUPPLEMENT_JOB_COMPLETE"

