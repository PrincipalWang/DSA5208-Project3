#!/bin/bash
#PBS -N supplement_analysis
#PBS -q auto_free
#PBS -l select=1:ncpus=1:mem=8gb
#PBS -l walltime=00:15:00
#PBS -j oe
set -e
source /etc/profile || true
module load matplotlib/3.10.3-gfbf-2025a
set -uo pipefail
PROJECT="$PBS_O_WORKDIR"
RUN_ROOT="${PROJECT3_SUPPLEMENT_RUN_ROOT:-/scratch/$USER/project3_supplement_runs}"
TARGET="${SUPPLEMENT_OUTPUT_DIR:-$HOME/dsa5208_project3_supplement_20261117/final/project3_supplement}"
LOG_DIR="${SUPPLEMENT_LOG_DIR:-$PROJECT/logs}"
python3 "$PROJECT/scripts/analyse_supplement.py" --single "$RUN_ROOT/supplement_single_$SUPPLEMENT_SINGLE" --two "$RUN_ROOT/supplement_two_$SUPPLEMENT_TWO" --project "$PROJECT" --output "$TARGET"
mkdir -p "$TARGET/logs"
cp -a "$LOG_DIR/single.log" "$LOG_DIR/two.log" "$LOG_DIR/submission.json" "$TARGET/logs/"
python3 -c 'from pathlib import Path; import shutil,sys; p=Path(sys.argv[1]); print(shutil.make_archive(str(p),"zip",root_dir=p.parent,base_dir=p.name))' "$TARGET"
echo "SUPPLEMENT_PACKAGE_COMPLETE"

